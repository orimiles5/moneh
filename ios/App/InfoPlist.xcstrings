    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moneh identifies the driver when a shift opens."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מונה מזהה את הנהג בפתיחת משמרת."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moneh uses your location to measure the trip distance while the meter is running. Your location stays on this device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מונה משתמש במיקום כדי למדוד את מרחק הנסיעה בזמן שהמונה פועל. המיקום נשאר במכשיר."
          }
        }
      }
    }
  },
  "version": "1.0"
