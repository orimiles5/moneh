    "onboarding.location.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To measure distance, Moneh uses your location only while the meter is running. It stays on this device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי למדוד את המרחק, מונה משתמש במיקום רק כשהמונה פועל. המיקום נשאר במכשיר."
          }
        }
      }
    },
