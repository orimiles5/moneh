    "agreedPrice.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meter still runs. If the fare ends up lower, the passenger pays the fare; if higher, the agreed price."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המונה פועל כרגיל. אם המחיר המחושב נמוך יותר, הנוסע משלם אותו; אם גבוה יותר, את המחיר המוסכם."
          }
        }
      }
    },
