    "notice.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moneh is a helper app that calculates the fare from the tariffs published by the Ministry of Transport. It is not a certified taxi meter and does not replace the meter installed in the taxi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מונה היא אפליקציית עזר לחישוב מחיר נסיעה לפי התעריפים שפרסם משרד התחבורה. היא אינה מונה מאושר ואינה מחליפה את המונה המותקן במונית."
          }
        }
      }
    },
